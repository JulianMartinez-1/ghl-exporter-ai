generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Una fila por cada clonado de un sitio/funnel de GoHighLevel.
model Export {
  id     String @id @default(cuid())
  url    String @db.Text // Link de GHL pegado por el usuario
  name   String // Nombre del proyecto / repo (slug)
  rawHtml String? @db.Text // HTML pegado manualmente (fallback cuando el crawl falla)

  status   ExportStatus @default(PENDING)
  progress Int          @default(0)

  extractionMethod ExtractionMethod?
  pagesCount       Int?

  githubRepoUrl  String?
  githubRepoName String?
  zipPath        String? // Ruta local del ZIP de respaldo, para descarga

  errorMessage String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs ExportLog[]

  @@map("exports")
}

model ExportLog {
  id        String   @id @default(cuid())
  exportId  String
  export    Export   @relation(fields: [exportId], references: [id], onDelete: Cascade)
  level     LogLevel @default(INFO)
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("export_logs")
}

enum ExportStatus {
  PENDING
  EXTRACTING
  CONVERTING
  PUSHING_TO_GITHUB
  COMPLETED
  FAILED
}

enum ExtractionMethod {
  PLAYWRIGHT
  FETCH
  HTML_PASTED
  HYBRID
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}
