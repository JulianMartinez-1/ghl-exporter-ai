# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos PostgreSQL — guarda el historial de exportaciones (Export/ExportLog)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# GitHub — token con permisos "repo" para crear repositorios y pushear archivos
GITHUB_TOKEN=ghp_your_github_token_here
# Login de una organización de GitHub. Déjalo vacío para crear los repos en tu
# cuenta personal (la de este token).
GITHUB_ORG=

# Carpeta local donde se guardan los ZIP de respaldo de cada exportación
# (por defecto: ./data/exports)
EXPORT_OUTPUT_DIR=./data/exports

# Máximo de páginas a rastrear por sitio/funnel (por defecto: 60)
CRAWL_MAX_PAGES=60
